rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isImageFile() {
      return request.resource.contentType.matches('image/.*') &&
             request.resource.size < 10 * 1024 * 1024; // max 10MB
    }

    // Public read for hotel, package, and banner photos
    match /uploads/{allPaths=**} {
      allow read: if true;
      allow write: if isSignedIn() && isImageFile();
    }

    match /users/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if isSignedIn() && request.auth.uid == userId && isImageFile();
    }

    match /{allPaths=**} {
      allow read: if true;
      allow write: if isSignedIn();
    }
  }
}
